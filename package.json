{
  "name": "memguard",
  "version": "1.3.0",
  "description": "Lightweight Windows memory guard with Codex MCP process cleanup.",
  "author": "MemGuard",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "bench:snapshot": "node src/snapshot-benchmark.js 1000",
    "bench:runtime": "node tools/runtime-benchmark.js",
    "smoke:dashboard": "node tools/dashboard-smoke.js",
    "smoke:widget": "node tools/widget-smoke.js",
    "verify": "node tools/verify.js",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "local.memguard.app",
    "productName": "MemGuard",
    "asar": false,
    "compression": "maximum",
    "afterPack": "build/afterPack.js",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/renderer.html",
      "src/renderer.js",
      "src/styles.css",
      "src/dashboard.html",
      "src/dashboard.js",
      "src/dashboard.css",
      "src/system-snapshot.js",
      "engine/**/*",
      "assets/**/*"
    ],
    "extraFiles": [
      "Start-MemGuard.vbs",
      "Install-or-Repair.bat",
      "Uninstall.bat",
      "Stop-MemGuard.ps1",
      "Install-MemGuard.ps1",
      "Install-Portable.ps1",
      "Uninstall-MemGuard.ps1",
      "Status-MemGuard.ps1",
      "使用说明.txt"
    ],
    "win": {
      "icon": "assets/memguard.ico",
      "artifactName": "${productName}-V${version}-${arch}.${ext}",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "guid": "38c7f744-07aa-5e8e-a081-2842a04c635a",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-V${version}.${ext}",
      "include": "build/installer.nsh",
      "shortcutName": "MemGuard"
    }
  },
  "devDependencies": {
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12"
  }
}
